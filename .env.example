# Copy this file to .env and fill in the blank values.
# .env is ignored by Git. Never commit real secrets.

NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://rickcommerce:rickcommerce@localhost:5432/rickcommerce_db
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

# Long random strings. Generate your own; leave blank here.
SESSION_SECRET=
PAYMENT_WEBHOOK_SECRET=

PAYMENT_PROVIDER=mock
PAYMENT_EXPIRY_MINUTES=30
SUPPORT_EMAIL=support@example.com